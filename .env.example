# --- AI Provider ---
# Options: anthropic | openai | gemini | ollama
LLM_PROVIDER=anthropic

# Model name (leave empty to use the provider default)
# Anthropic: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
# OpenAI:    gpt-4o-mini | gpt-4o
# Gemini:    gemini-1.5-flash | gemini-1.5-pro
# Ollama:    llama3 | mistral | deepseek-coder
LLM_MODEL=

# Only required for Ollama (self-hosted)
LLM_API_URL=http://localhost:11434

# --- API Keys ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# --- Platform Credentials ---
LINKEDIN_EMAIL=you@email.com
LINKEDIN_PASSWORD=yourpassword

GUPY_EMAIL=you@email.com
GUPY_PASSWORD=yourpassword

# --- Telegram Notifications (optional) ---
# Create a bot at https://t.me/BotFather, then send a message to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email Notifications (optional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_TO=you@gmail.com
