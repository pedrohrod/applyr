FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir fastapi>=0.111.0 uvicorn>=0.30.0 sqlalchemy>=2.0.0 pyyaml>=6.0.1 loguru>=0.7.2

COPY dashboard/ ./dashboard/
COPY src/tracker/ ./src/tracker/
COPY src/__init__.py ./src/
COPY src/tracker/__init__.py ./src/tracker/

EXPOSE 8080

CMD ["uvicorn", "dashboard.app:app", "--host", "0.0.0.0", "--port", "8080"]
